# Allow-list: ignore everything by default, then explicitly un-ignore
# only what the app + its docs actually need. This protects against
# unrelated folders (like ds-book-template-main) ever getting committed
# by accident, even if they show up in this same Desktop folder later.
*

!index.html
!data.js
!toc.yml
!groups.yml
!check-answer-balance.js
!package.json
!.githooks/
!.githooks/**
!.github/
!.github/**
!README.md
!CLAUDE.md
!DESIGN.md
!PRODUCT.md
!topic-repo-map.md
!.gitignore

!assets/
!assets/**

!.claude/
!.claude/**
